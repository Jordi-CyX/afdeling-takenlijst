// STAP 2 (beveiliging) – 2026-11-18
// - Claimen van een medewerker kan alleen nog met een eenmalige startcode van de admin
//   (startCodes/{code}, 7 dagen geldig). Naam typen alleen geeft geen toegang meer.
// - Inactieve medewerkers (active == false) worden geweigerd (isValidStaff).
// - Optie A: accounts zonder startCode (oude methode) worden voor alles geweigerd (isValidStaff).
// - Een pincode-resetverzoek blijft alleen een verzoek; het geeft geen toegang.
// - Foto's moeten data:image/(jpeg|png|webp);base64,... zijn.
// STAP 3 (veiligheidsaudit 18-11-2026 23:05)
// - H1/M1: nameIndex alleen nog voor admin; claim = staffAccounts + startCodes (geen loginKey meer).
//   Een startcode is voor niet-admins alleen te lezen zolang hij ongebruikt en niet verlopen is.
// - M2: pinResetRequests met willekeurig id, {name 1-60, requestedAt, note <= 200}, alleen aanmaken.
// - M3/L9: limieten op alle staff-strings/-lijsten/-foto's (foto <= 250000 tekens), datums vandaag +/- 1 dag.
// - L1: streefdatum in taskMeta/{taskId} (alleen admin + reader).
// - L2: afvinken alleen eigen taak, "Allen" of niet toegewezen; terugzetten alleen door wie afvinkte.
// - L3: medewerkers lezen alleen hun eigen employees-doc (geen lijst).
// STAP 4 (hercontrole 19-11-2026)
// - M2/N3: resetverzoek alleen samen met pinResetLimits/{uid} (10 min per uid) en
//   pinResetLimits/_global (60 s en max. 20 per dag voor iedereen samen) in dezelfde batch.
// - M3: eigen taken en meldingen alleen samen met staffDailyCounters/{employeeId} in dezelfde
//   batch: max. 10 eigen taken en 5 meldingen per dag per medewerker, 15 s tussen verzendingen.
//   Dag = kalenderdag in UTC+1 (Amsterdamse wintertijd; in de zomer wisselt de dag om 01:00).
// - Admin v24: employeeDetails/{employeeId} (extra gegevens per medewerker), alleen admin,
//   vaste veldenlijst; geen gevoelige persoonsgegevens.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == "Of3mAU2qJeczN6NDUfkgT73kfJn1";
    }

    function isReader() {
      return isSignedIn() && request.auth.uid == "2xZjAuMgnYUjMg6Mg4ivPhEOIFr2";
    }

    function employeeDoc(employeeId) {
      return get(/databases/$(database)/documents/employees/$(employeeId));
    }

    function employeePinVersion(data) {
      return ("pinVersion" in data && data.pinVersion is int) ? data.pinVersion : 0;
    }

    function staffAccountPath() {
      return /databases/$(database)/documents/staffAccounts/$(request.auth.uid);
    }

    function staffAccount() {
      return get(staffAccountPath()).data;
    }

    function staffEmployeeId() {
      return staffAccount().employeeId;
    }

    function staffEmployee() {
      return employeeDoc(staffEmployeeId()).data;
    }

    function isActiveEmployee(data) {
      return data.get("active", true) != false;
    }

    function isValidStaff() {
      return isSignedIn()
        && exists(staffAccountPath())
        && staffAccount().employeeId is string
        && isStartCodeFormat(staffAccount().get("startCode", null))
        && exists(/databases/$(database)/documents/employees/$(staffEmployeeId()))
        && isActiveEmployee(staffEmployee())
        && employeePinVersion(staffEmployee()) == staffAccount().pinVersion;
    }

    // Startcode: 10 tekens uit A-Z en 2-9 zonder 0, O, 1, I en L (doc id = code, hoofdletters).
    function isStartCodeFormat(code) {
      return code is string && code.matches("^[A-HJKMNP-Z2-9]{10}$");
    }

    function startCodePath(code) {
      return /databases/$(database)/documents/startCodes/$(code);
    }

    function expectedStartCodeEmail(employeeId, pinVersion, code) {
      return ("emp-" + employeeId + "-v" + string(pinVersion) + "-" + code.lower() + "@zeiklijst.app").lower();
    }

    function tokenEmailIs(expected) {
      return request.auth.token.email is string
        && request.auth.token.email.lower() == expected;
    }

    // ISO-datum/tijd zoals new Date().toISOString(), max 40 tekens.
    function isIsoDateTime(s) {
      return s is string
        && s.size() <= 40
        && s.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+\\-][0-9]{2}:[0-9]{2})$");
    }

    // Kalenderdag (UTC-middernacht) van een string die begint met YYYY-MM-DD.
    function dayOf(s) {
      let p = s.split("T")[0].split("-");
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    // Dag ligt tussen (vandaag - daysBack) en (vandaag + daysAhead), met 1 dag marge voor tijdzones.
    function isNearToday(s, daysBack, daysAhead) {
      return dayOf(s) >= request.time - duration.value(daysBack + 1, "d")
        && dayOf(s) <= request.time + duration.value(daysAhead, "d");
    }

    // Maximale fotogrootte (tekens van de data-URL), ca. 180 KB beeld. Gelijk aan ZL v19.
    function maxPhotoChars() {
      return 250000;
    }

    // Alleen veilige foto's: data:image/(jpeg|png|webp);base64,...
    function isSafePhoto(p, maxSize) {
      return p is string
        && p.size() <= maxSize
        && p.matches("^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$");
    }

    function isActiveTemplate(tpl) {
      return !("paused" in tpl) || tpl.paused == false;
    }

    function templateMatches(task, tpl) {
      return task.title == tpl.title
        && task.description == tpl.description
        && task.assigneeId == (("assigneeId" in tpl) ? tpl.assigneeId : "")
        && task.assigneeName == (("assigneeName" in tpl) ? tpl.assigneeName : "")
        && (("location" in task) ? task.location : "") == (("location" in tpl) ? tpl.location : "")
        && task.photos == (("photos" in tpl) ? tpl.photos : []);
    }

    function isValidOccurrenceId(taskId, data) {
      return data.recurringId is string
        && data.occurrenceDate is string
        && data.occurrenceDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.recurringId.size() <= 100
        && taskId == data.recurringId + "_" + data.occurrenceDate;
    }

    function hasAllowedTaskKeys(data) {
      return data.keys().hasOnly([
        "title",
        "description",
        "assigneeId",
        "assigneeName",
        "status",
        "createdAt",
        "pendingAt",
        "pendingBy",
        "completedAt",
        "recurringId",
        "occurrenceDate",
        "photos",
        "location"
      ]);
    }

    function isValidRecurringInstance(taskId) {
      let data = request.resource.data;
      let recId = data.recurringId;
      let recPath = /databases/$(database)/documents/recurring/$(recId);
      return isValidOccurrenceId(taskId, data)
        && hasAllowedTaskKeys(data)
        && data.status == "open"
        && data.title is string
        && data.description is string
        && data.assigneeId is string
        && data.assigneeName is string
        && isIsoDateTime(data.createdAt)
        && isNearToday(data.createdAt, 1, 1)
        && isNearToday(data.occurrenceDate, 1, 1)
        && (!("pendingAt" in data) || data.pendingAt == null)
        && (!("pendingBy" in data) || data.pendingBy == null)
        && (!("completedAt" in data) || data.completedAt == null)
        && data.photos is list
        && data.photos.size() <= 4
        && (!("location" in data) || data.location is string)
        && exists(recPath)
        && isActiveTemplate(get(recPath).data)
        && templateMatches(data, get(recPath).data);
    }

    function pendingByEmployeeIdCleared() {
      return !("pendingByEmployeeId" in request.resource.data)
        || request.resource.data.pendingByEmployeeId == null;
    }

    // L2: alleen eigen taak, taak voor "Allen" of niet-toegewezen taak.
    function isOwnOrSharedTask() {
      return resource.data.get("assigneeId", "") in [staffEmployeeId(), "ALLEN", "", null];
    }

    function isStatusToggle() {
      return isOwnOrSharedTask()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "pendingAt", "pendingBy", "pendingByEmployeeId"])
        && (
          (
            resource.data.status == "open"
            && request.resource.data.status == "pending"
            && isIsoDateTime(request.resource.data.pendingAt)
            && isNearToday(request.resource.data.pendingAt, 1, 1)
            && request.resource.data.pendingBy is string
            && request.resource.data.pendingBy.size() <= 60
            && request.resource.data.pendingBy == staffEmployee().name
            && request.resource.data.get("pendingByEmployeeId", null) == staffEmployeeId()
          )
          || (
            resource.data.status == "pending"
            && request.resource.data.status == "open"
            && request.resource.data.pendingAt == null
            && request.resource.data.pendingBy == null
            && pendingByEmployeeIdCleared()
            && resource.data.get("pendingByEmployeeId", null) in [staffEmployeeId(), null]
          )
        );
    }

    function isNullOrMissing(data, key) {
      return !(key in data) || data[key] == null;
    }

    function isValidStaffTaskCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "title",
          "description",
          "location",
          "assigneeId",
          "assigneeName",
          "status",
          "createdAt",
          "photos",
          "createdByRole",
          "createdByEmployeeId",
          "createdByName",
          "adminReview",
          "recurringId",
          "occurrenceDate",
          "pendingAt",
          "pendingBy",
          "completedAt"
        ])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && (!("description" in data) || (data.description is string && data.description.size() <= 2000))
        && (!("location" in data) || (data.location is string && data.location.size() <= 120))
        && data.assigneeId == staffEmployeeId()
        && data.assigneeName == staffEmployee().name
        && data.status == "open"
        && isIsoDateTime(data.createdAt)
        && isNearToday(data.createdAt, 1, 1)
        && (!("photos" in data) || (
          data.photos is list
          && data.photos.size() <= 1
          && (data.photos.size() == 0 || isSafePhoto(data.photos[0], maxPhotoChars()))
        ))
        && data.createdByRole == "staff"
        && data.createdByEmployeeId == staffEmployeeId()
        && data.createdByName == staffEmployee().name
        && data.adminReview == "nieuw"
        && isNullOrMissing(data, "recurringId")
        && isNullOrMissing(data, "occurrenceDate")
        && isNullOrMissing(data, "pendingAt")
        && isNullOrMissing(data, "pendingBy")
        && isNullOrMissing(data, "completedAt");
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || isValidStaff() || isReader();
      allow create: if isAdmin()
        || (isValidStaff() && isValidRecurringInstance(taskId))
        || (isValidStaff() && isValidStaffTaskCreate() && counterBumpedFor("task", taskId));
      allow update: if isAdmin() || (isValidStaff() && isStatusToggle());
      allow delete: if isAdmin();
    }

    match /recurring/{recurringId} {
      allow read: if isAdmin() || isValidStaff();
      allow create, update, delete: if isAdmin();
    }

    // L1: streefdatum en andere adminvelden per taak; medewerkers kunnen dit niet lezen.
    match /taskMeta/{taskId} {
      allow read: if isAdmin() || isReader();
      allow create, update, delete: if isAdmin();
    }

    // L3: medewerkers lezen alleen hun eigen medewerker-doc (ook als inactief), met een geldig
    // staffAccount (zelfde employeeId, geldige startCode, pinVersion klopt). Geen lijst.
    function isOwnEmployeeDoc(employeeId) {
      return isSignedIn()
        && exists(staffAccountPath())
        && staffAccount().employeeId == employeeId
        && isStartCodeFormat(staffAccount().get("startCode", null))
        && staffAccount().pinVersion == employeePinVersion(resource.data);
    }

    match /employees/{employeeId} {
      allow get: if isAdmin() || isReader() || isOwnEmployeeDoc(employeeId);
      allow list: if isAdmin() || isReader();
      allow create, update, delete: if isAdmin();
    }

    // Admin v24: extra gegevens per medewerker. Alleen admin (niet staff, niet de reader),
    // apart van employees/{id} omdat medewerkers hun eigen employees-doc en de reader alle
    // employees-docs kunnen lezen. Alle velden behalve updatedAt zijn optioneel (leeg = weglaten).
    function isValidEmployeeDetails(employeeId) {
      let data = request.resource.data;
      return exists(/databases/$(database)/documents/employees/$(employeeId))
        && data.keys().hasOnly(["role", "staffNumber", "contractHours", "workdays", "startDate", "note", "updatedAt"])
        && data.updatedAt == request.time
        && (!("role" in data) || (data.role is string && data.role.trim().size() >= 1 && data.role.size() <= 40))
        && (!("staffNumber" in data) || (data.staffNumber is string && data.staffNumber.matches("^[A-Za-z0-9]{1,20}$")))
        && (!("contractHours" in data) || ((data.contractHours is int || data.contractHours is float)
          && data.contractHours >= 0 && data.contractHours <= 48))
        && (!("workdays" in data) || (data.workdays is list
          && data.workdays.size() <= 7
          && data.workdays.toSet().size() == data.workdays.size()
          && data.workdays.toSet().hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && (!("startDate" in data) || (data.startDate is string
          && data.startDate.matches("^(19[6-9][0-9]|20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$")
          && dayOf(data.startDate) <= request.time + duration.value(366, "d")))
        && (!("note" in data) || (data.note is string && data.note.size() <= 500));
    }

    match /employeeDetails/{employeeId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidEmployeeDetails(employeeId);
    }

    // H1/M1: nameIndex is alleen nog voor de admin (medewerkers gebruiken het niet meer).
    match /nameIndex/{nameKey} {
      allow read, write: if isAdmin();
    }

    match /staffAccounts/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || isValidStaffAccountCreate(uid);
      allow update, delete: if isAdmin();
    }

    // Stap 1 van de claim-batch: staffAccounts/{uid} = {employeeId, pinVersion, startCode}.
    function isValidStaffAccountCreate(uid) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == uid
        && data.keys().hasOnly(["employeeId", "pinVersion", "startCode"])
        && data.employeeId is string
        && data.pinVersion is int
        && isStartCodeFormat(data.startCode)
        && exists(startCodePath(data.startCode))
        && get(startCodePath(data.startCode)).data.used == false
        && get(startCodePath(data.startCode)).data.expiresAt > request.time
        && get(startCodePath(data.startCode)).data.employeeId == data.employeeId
        && get(startCodePath(data.startCode)).data.pinVersion == data.pinVersion
        && exists(/databases/$(database)/documents/employees/$(data.employeeId))
        && isActiveEmployee(employeeDoc(data.employeeId).data)
        && employeePinVersion(employeeDoc(data.employeeId).data) == data.pinVersion
        && tokenEmailIs(expectedStartCodeEmail(data.employeeId, data.pinVersion, data.startCode))
        && getAfter(startCodePath(data.startCode)).data.used == true
        && getAfter(startCodePath(data.startCode)).data.usedBy == uid;
    }

    // Niet-admins: alleen een ongebruikte, niet-verlopen code opvragen (doc-id = code).
    match /startCodes/{code} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.used == false && resource.data.expiresAt > request.time);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isStartCodeClaim(code);
    }

    // Stap 2 van de claim-batch: {used:true, usedBy: uid, usedAt: request.time}.
    function isStartCodeClaim(code) {
      let after = getAfter(staffAccountPath()).data;
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "usedBy", "usedAt"])
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(staffAccountPath())
        && after.startCode == code
        && after.employeeId == resource.data.employeeId
        && after.pinVersion == resource.data.pinVersion;
    }

    // M2: verzoek met willekeurig id, alleen aanmaken, nooit overschrijven.
    // De admin koppelt de naam zelf aan een medewerker.
    // M2/N3 (stap 4): alleen in een batch die ook pinResetLimits/{uid} en pinResetLimits/_global
    // bijwerkt (wachttijd, zie isValidPinResetLimitWrite).
    match /pinResetRequests/{requestId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn() && isValidPinResetCreate(requestId) && resetLimitsBumpedFor(requestId);
    }

    // Wachttijd tussen resetverzoeken (servertijd, dus geen last van verkeerde klokken).
    function pinResetUidCooldown() {
      return duration.value(600, "s");
    }

    function pinResetGlobalCooldown() {
      return duration.value(60, "s");
    }

    function pinResetLimitPath(limitId) {
      return /databases/$(database)/documents/pinResetLimits/$(limitId);
    }

    function pinResetRequestPath(requestId) {
      return /databases/$(database)/documents/pinResetRequests/$(requestId);
    }

    function limitPointsTo(limitId, requestId) {
      return existsAfter(pinResetLimitPath(limitId))
        && getAfter(pinResetLimitPath(limitId)).data.lastAt == request.time
        && getAfter(pinResetLimitPath(limitId)).data.requestId == requestId;
    }

    function resetLimitsBumpedFor(requestId) {
      return limitPointsTo(request.auth.uid, requestId) && limitPointsTo("_global", requestId);
    }

    function pinResetGlobalPerDay() {
      return 20;
    }

    // Gedeeld door beide limietdocs: koppeling aan precies dit nieuwe verzoek, servertijd.
    function isLimitBoundToNewRequest(data) {
      return data.lastAt == request.time
        && data.requestId is string
        && data.requestId.matches("^[A-Za-z0-9]{16,40}$")
        && !exists(pinResetRequestPath(data.requestId))
        && existsAfter(pinResetRequestPath(data.requestId));
    }

    // pinResetLimits/{uid} = { lastAt: serverTimestamp(), requestId }. Pas na 600 s opnieuw.
    function isValidPinResetUidLimitWrite(limitId) {
      let data = request.resource.data;
      return limitId == request.auth.uid
        && data.keys().hasOnly(["lastAt", "requestId"])
        && data.keys().hasAll(["lastAt", "requestId"])
        && isLimitBoundToNewRequest(data)
        && (resource == null || resource.data.lastAt + pinResetUidCooldown() <= request.time);
    }

    // pinResetLimits/_global = { lastAt: serverTimestamp(), requestId, day: int, count: int }.
    // Voor alle aanvragers samen: pas na 60 s opnieuw en max. 20 per dag (dag zoals staffDayNumber).
    function isValidPinResetGlobalLimitWrite() {
      let data = request.resource.data;
      let today = staffDayNumber();
      let prevCount = (resource != null && resource.data.get("day", -1) == today)
        ? resource.data.get("count", 0) : 0;
      return data.keys().hasOnly(["lastAt", "requestId", "day", "count"])
        && data.keys().hasAll(["lastAt", "requestId", "day", "count"])
        && isLimitBoundToNewRequest(data)
        && data.day is int
        && data.day == today
        && data.count is int
        && data.count == prevCount + 1
        && data.count <= pinResetGlobalPerDay()
        && (resource == null || resource.data.lastAt + pinResetGlobalCooldown() <= request.time);
    }

    function isValidPinResetLimitWrite(limitId) {
      return isSignedIn()
        && (limitId == "_global" ? isValidPinResetGlobalLimitWrite() : isValidPinResetUidLimitWrite(limitId));
    }

    match /pinResetLimits/{limitId} {
      allow get: if isAdmin() || (isSignedIn() && (limitId == request.auth.uid || limitId == "_global"));
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || isValidPinResetLimitWrite(limitId);
    }

    // M3 (stap 4): dagteller per medewerker voor eigen taken en meldingen.
    // staffDailyCounters/{employeeId} = { day: int, tasks: int, reports: int, lastAt: timestamp,
    //   lastType: "task" | "report", lastId: string }
    function maxStaffTasksPerDay() {
      return 10;
    }

    function maxStaffReportsPerDay() {
      return 5;
    }

    function staffSubmitCooldown() {
      return duration.value(15, "s");
    }

    // Dagnummer = floor((ms sinds 1970 + 1 uur) / 1 dag): kalenderdag in UTC+1.
    function staffDayNumber() {
      return math.floor((request.time.toMillis() + 3600000) / 86400000);
    }

    function staffCounterPath(employeeId) {
      return /databases/$(database)/documents/staffDailyCounters/$(employeeId);
    }

    function collectionDocPath(kind, docId) {
      return kind == "task"
        ? /databases/$(database)/documents/tasks/$(docId)
        : /databases/$(database)/documents/reports/$(docId);
    }

    // Aan te roepen bij het aanmaken van een taak/melding: de teller in dezelfde batch wijst ernaar.
    function counterBumpedFor(kind, docId) {
      let path = staffCounterPath(staffEmployeeId());
      return existsAfter(path)
        && getAfter(path).data.lastAt == request.time
        && getAfter(path).data.lastType == kind
        && getAfter(path).data.lastId == docId;
    }

    function isValidCounterWrite(employeeId) {
      let data = request.resource.data;
      let today = staffDayNumber();
      let isNew = resource == null;
      let sameDay = !isNew && resource.data.get("day", -1) == today;
      let prevTasks = sameDay ? resource.data.get("tasks", 0) : 0;
      let prevReports = sameDay ? resource.data.get("reports", 0) : 0;
      return isValidStaff()
        && staffEmployeeId() == employeeId
        && data.keys().hasOnly(["day", "tasks", "reports", "lastAt", "lastType", "lastId"])
        && data.keys().hasAll(["day", "tasks", "reports", "lastAt", "lastType", "lastId"])
        && data.day is int
        && data.day == today
        && data.tasks is int
        && data.reports is int
        && data.lastAt == request.time
        && (isNew || resource.data.lastAt + staffSubmitCooldown() <= request.time)
        && data.lastId is string
        && data.lastId.matches("^[A-Za-z0-9]{16,40}$")
        && data.lastType in ["task", "report"]
        && (
          (
            data.lastType == "task"
            && data.tasks == prevTasks + 1
            && data.reports == prevReports
            && data.tasks <= maxStaffTasksPerDay()
          )
          || (
            data.lastType == "report"
            && data.reports == prevReports + 1
            && data.tasks == prevTasks
            && data.reports <= maxStaffReportsPerDay()
          )
        )
        && !exists(collectionDocPath(data.lastType, data.lastId))
        && existsAfter(collectionDocPath(data.lastType, data.lastId));
    }

    match /staffDailyCounters/{employeeId} {
      allow get: if isAdmin() || (isValidStaff() && staffEmployeeId() == employeeId);
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || isValidCounterWrite(employeeId);
    }

    function isValidPinResetCreate(requestId) {
      let data = request.resource.data;
      return requestId.matches("^[A-Za-z0-9]{16,40}$")
        && data.keys().hasOnly(["name", "requestedAt", "note"])
        && data.keys().hasAll(["name", "requestedAt"])
        && data.name is string
        && data.name.trim().size() >= 1
        && data.name.size() <= 60
        && data.requestedAt == request.time
        && (!("note" in data) || (data.note is string && data.note.size() <= 200));
    }

    function isValidReportCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "description",
          "photo",
          "employeeId",
          "employeeName",
          "createdAt",
          "appVersion",
          "device",
          "status"
        ])
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 1000
        && (!("photo" in data) || isSafePhoto(data.photo, maxPhotoChars()))
        && data.employeeId == staffEmployeeId()
        && data.employeeName == staffEmployee().name
        && data.createdAt == request.time
        && data.appVersion is string
        && data.appVersion.size() <= 40
        && data.device is string
        && data.device.size() <= 300
        && data.status == "nieuw";
    }

    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidStaff() && isValidReportCreate() && counterBumpedFor("report", reportId);
    }
  }
}
