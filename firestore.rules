// MAINTENANCE LOCKDOWN 2026-11-18
// Medewerkers-app tijdelijk offline wegens beveiligingsfixes.
// - Alleen de admin (isAdmin) heeft toegang, zoals voorheen (lezen + schrijven).
// - Het alleen-lezen account (isReader, zl-assistent-reader) mag tasks en employees lezen.
// - Al het andere is geweigerd: geen medewerker-login/claim (nameIndex, staffAccounts),
//   geen pincode-resetverzoeken, geen taak-updates of -aanmaak door medewerkers,
//   geen meldingen/foto-uploads (reports), geen anonieme reads.
// Herstel: vorige regels staan in git (commit voor deze lockdown) en in
// /workspace/outputs/firestore-rules-reader-duedate.txt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == "Of3mAU2qJeczN6NDUfkgT73kfJn1";
    }

    function isReader() {
      return isSignedIn() && request.auth.uid == "2xZjAuMgnYUjMg6Mg4ivPhEOIFr2";
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || isReader();
      allow create, update, delete: if isAdmin();
    }

    match /recurring/{recurringId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || isReader();
      allow create, update, delete: if isAdmin();
    }

    match /nameIndex/{nameKey} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /staffAccounts/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pinResetRequests/{employeeId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Alles wat hierboven niet genoemd is: standaard geweigerd.
  }
}
